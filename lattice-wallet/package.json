{
  "name": "lattice-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Lattice — a non-custodial mobile wallet for the XRIQ chain (testnet), with post-quantum-ready signing.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:core": "tsx __tests__/conformance.ts && tsx __tests__/rust-vectors.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@noble/post-quantum": "^0.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@scure/bip39": "^1.4.0",
    "expo": "~52.0.0",
    "expo-clipboard": "~7.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
