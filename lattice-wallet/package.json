{
  "name": "lattice-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Lattice — a non-custodial multi-chain mobile wallet (XRIQ, Ethereum/EVM, Bitcoin, Solana, Zcash) with post-quantum-ready signing.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:core": "tsx __tests__/conformance.ts && tsx __tests__/rust-vectors.ts && tsx __tests__/eth-vectors.ts && tsx __tests__/btc-vectors.ts && tsx __tests__/sol-vectors.ts && tsx __tests__/zec-vectors.ts && tsx __tests__/zec-sighash-vectors.ts && tsx __tests__/erc20-vectors.ts && tsx __tests__/evm-sign-vectors.ts && tsx __tests__/sim-vectors.ts && tsx __tests__/deeplink-vectors.ts && tsx __tests__/wc-chains-vectors.ts",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform all --output-dir dist",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@noble/post-quantum": "^0.2.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@reown/walletkit": "^1.5.6",
    "@scure/base": "^1.1.9",
    "@scure/bip32": "^1.5.0",
    "@scure/bip39": "^1.4.0",
    "@scure/btc-signer": "^1.8.1",
    "@walletconnect/core": "^2.23.10",
    "@walletconnect/react-native-compat": "^2.23.10",
    "@walletconnect/utils": "^2.23.10",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.0",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "~15.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@solana/web3.js": "^1.98.4",
    "@types/react": "~18.3.12",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.17.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
