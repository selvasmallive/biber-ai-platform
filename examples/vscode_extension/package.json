{
  "name": "biber-ai-assistant",
  "displayName": "BIBER AI Assistant",
  "description": "Secure VS Code client for BIBER AI orchestration planning.",
  "version": "0.3.0",
  "publisher": "flat-electronics-canada",
  "license": "SEE LICENSE IN LICENSE.md",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "biber",
    "ai",
    "coding-assistant",
    "orchestration",
    "repo-context",
    "local-model",
    "openai-compatible"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/selvasmallive/biber-ai-platform.git"
  },
  "homepage": "https://api.beaverapi.com",
  "bugs": {
    "url": "https://github.com/selvasmallive/biber-ai-platform/issues"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "BIBER only sends bounded path hints and user-entered instructions in this release; it does not read or upload file contents."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "BIBER can test the API connection in virtual workspaces. Orchestration path hints depend on VS Code workspace-relative file paths."
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:biber.changeAgentView",
    "onCommand:biber.openChat",
    "onCommand:biber.openSetup",
    "onCommand:biber.setApiKey",
    "onCommand:biber.clearApiKey",
    "onCommand:biber.testConnection",
    "onCommand:biber.orchestrationPlan",
    "onCommand:biber.openOutput",
    "onCommand:biber.refreshSidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "biber.openChat",
        "title": "BIBER: Open Chat Agent",
        "category": "BIBER",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "biber.openSetup",
        "title": "BIBER: Setup API Connection",
        "category": "BIBER",
        "icon": "$(key)"
      },
      {
        "command": "biber.setApiKey",
        "title": "BIBER: Set API Key",
        "category": "BIBER"
      },
      {
        "command": "biber.clearApiKey",
        "title": "BIBER: Clear API Key",
        "category": "BIBER"
      },
      {
        "command": "biber.testConnection",
        "title": "BIBER: Test API Connection",
        "category": "BIBER",
        "icon": "$(plug)"
      },
      {
        "command": "biber.orchestrationPlan",
        "title": "BIBER: Plan Change",
        "category": "BIBER",
        "icon": "$(sparkle)"
      },
      {
        "command": "biber.openOutput",
        "title": "BIBER: Show Output",
        "category": "BIBER",
        "icon": "$(output)"
      },
      {
        "command": "biber.refreshSidebar",
        "title": "BIBER: Refresh",
        "category": "BIBER",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "biber",
          "title": "BIBER",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "biber": [
        {
          "id": "biber.changeAgentView",
          "name": "Chat Agent",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "biber.changeAgentView",
        "contents": "Open the BIBER AI Chat Agent, save setup, test the API, then ask BIBER for a change plan.\n[Open Chat Agent](command:biber.openChat)\n[Setup API Connection](command:biber.openSetup)\n[Test API Connection](command:biber.testConnection)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "biber.refreshSidebar",
          "when": "view == biber.changeAgentView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "BIBER",
      "properties": {
        "biber.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.beaverapi.com/v1",
          "description": "OpenAI-compatible BIBER API base URL. Use http://127.0.0.1:8000/v1 only for a private development tunnel."
        },
        "biber.model": {
          "type": "string",
          "default": "biber-dev-core-v1",
          "description": "BIBER model id to request."
        },
        "biber.maxRequestsPerMinute": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 60,
          "description": "Client-side per-window request limit before calling BIBER."
        },
        "biber.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "Maximum time to wait for one BIBER API request."
        },
        "biber.maxPromptChars": {
          "type": "number",
          "default": 4000,
          "minimum": 200,
          "maximum": 20000,
          "description": "Maximum user instruction length sent to BIBER."
        },
        "biber.maxChangedPaths": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum workspace-relative path hints sent to orchestration."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "@types/vscode": "1.92.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "5.5.4"
  },
  "icon": "media/icon.png"
}
