{
  "name": "biber-ai-azure-devops",
  "version": "0.1.0",
  "private": true,
  "description": "Azure DevOps extension scaffold for private BIBER AI PR and commit review.",
  "scripts": {
    "validate": "node ../../scripts/biber_azure_devops_publisher_readiness_smoke.js",
    "validate:panel": "node ../../scripts/biber_azure_devops_panel_behavior_smoke.js",
    "validate:pipeline": "node ../../scripts/biber_azure_devops_pipeline_readiness_smoke.js",
    "validate:contract": "python ../../scripts/biber_azure_devops_review_smoke.py",
    "validate:wrapper": "python ../../scripts/biber_azure_devops_task_wrapper_smoke.py",
    "demo:offline": "node ../../scripts/biber_azure_devops_offline_demo_bundle_smoke.js",
    "validate:conference": "python ../../scripts/biber_azure_devops_conference_pack_smoke.py",
    "package": "tfx extension create --manifest-globs vss-extension.json"
  },
  "devDependencies": {
    "tfx-cli": "^0.17.0"
  }
}
