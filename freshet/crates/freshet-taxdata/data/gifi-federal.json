{
  "tax_year": 2025,
  "province": "on",
  "_comment": "GIFI, the General Index of Financial Information. Codes and names checked against CRA RC4088 and the GIFI-Short guide RC4089 on 2026-09-15. The item set is GIFI-Short's (form T1178), a published CRA subset aimed at corporations under a million in revenue and assets. A corporation using tax software cannot file T1178 itself, so these are transmitted on the full Schedules 100 and 125 — the codes are the same codes either way.",
  "summary": [],
  "checks": [
    {
      "id": "gifi.does_not_balance",
      "severity": "error",
      "message": "The balance sheet does not balance.",
      "help": "Total assets must equal total liabilities plus equity. A difference means something is missing or mistyped in the financial statement figures, and the return cannot be filed until it is resolved.",
      "when": {
        "cmp": "or",
        "any": [
          {
            "cmp": "gt",
            "left": {
              "op": "line",
              "id": "gifi.balance_difference"
            },
            "right": {
              "op": "const",
              "value": "0"
            }
          },
          {
            "cmp": "lt",
            "left": {
              "op": "line",
              "id": "gifi.balance_difference"
            },
            "right": {
              "op": "const",
              "value": "0"
            }
          }
        ]
      }
    },
    {
      "id": "gifi.subset_only",
      "severity": "warning",
      "message": "The GIFI code set is the short one.",
      "help": "Freshet carries the GIFI-Short item set (CRA form T1178), which covers corporations under a million dollars in revenue and assets. A corporation whose statements need a code outside it can put the amount in other revenue or other expenses, but the return will not carry the more specific code to CRA.",
      "when": {
        "cmp": "gte",
        "left": {
          "op": "const",
          "value": "1"
        },
        "right": {
          "op": "const",
          "value": "1"
        }
      }
    },
    {
      "id": "gifi.no_statements",
      "severity": "warning",
      "message": "No financial statement figures have been entered.",
      "help": "A T2 is filed with GIFI schedules. Without them the return has nothing to reconcile from.",
      "when": {
        "cmp": "and",
        "all": [
          {
            "cmp": "lte",
            "left": {
              "op": "line",
              "id": "gifi.8299"
            },
            "right": {
              "op": "const",
              "value": "0"
            }
          },
          {
            "cmp": "lte",
            "left": {
              "op": "line",
              "id": "gifi.2599"
            },
            "right": {
              "op": "const",
              "value": "0"
            }
          }
        ]
      }
    }
  ],
