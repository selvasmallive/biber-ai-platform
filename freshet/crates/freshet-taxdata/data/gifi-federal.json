{
  "tax_year": 2025,
  "province": "on",
  "_comment": "GIFI: Schedule 100 (balance sheet) and Schedule 125 (income statement). A representative code set rather than the full taxonomy — the codes are entered amounts and the totals are sums over them, so extending the set is data rather than design.",
  "summary": [],
  "checks": [
    {
      "id": "gifi.does_not_balance",
      "severity": "error",
      "message": "The balance sheet does not balance.",
      "help": "Total assets must equal total liabilities plus equity. A difference means something is missing or mistyped in the financial statement figures, and the return cannot be filed until it is resolved.",
      "when": {
        "cmp": "or",
        "any": [
          {
            "cmp": "gt",
            "left": {
              "op": "line",
              "id": "gifi.balance_difference"
            },
            "right": {
              "op": "const",
              "value": "0"
            }
          },
          {
            "cmp": "lt",
            "left": {
              "op": "line",
              "id": "gifi.balance_difference"
            },
            "right": {
              "op": "const",
              "value": "0"
            }
          }
        ]
      }
    },
    {
      "id": "gifi.subset_only",
      "severity": "warning",
      "message": "Only part of the GIFI code set is available.",
      "help": "The common accounts are here. A corporation whose statements need a code that is missing can put the amount in other expenses, but the return will not carry the correct code to CRA.",
      "when": {
        "cmp": "gte",
        "left": {
          "op": "const",
          "value": "1"
        },
        "right": {
          "op": "const",
          "value": "1"
        }
      }
    },
    {
      "id": "gifi.no_statements",
      "severity": "warning",
      "message": "No financial statement figures have been entered.",
      "help": "A T2 is filed with GIFI schedules. Without them the return has nothing to reconcile from.",
      "when": {
        "cmp": "and",
        "all": [
          {
            "cmp": "lte",
            "left": {
              "op": "line",
              "id": "gifi.8299"
            },
            "right": {
              "op": "const",
              "value": "0"
            }
          },
          {
            "cmp": "lte",
            "left": {
              "op": "line",
              "id": "gifi.2599"
            },
            "right": {
              "op": "const",
              "value": "0"
            }
          }
        ]
      }
    }
  ],
  "lines": [
    {
      "id": "gifi.1000",
      "label": "Cash and deposits",
      "expr": {
        "op": "fact",
        "key": "gifi.1000"
      }
    },
    {
      "id": "gifi.1060",
      "label": "Accounts receivable",
      "expr": {
        "op": "fact",
        "key": "gifi.1060"
      }
    },
    {
      "id": "gifi.1120",
      "label": "Inventories",
      "expr": {
        "op": "fact",
        "key": "gifi.1120"
      }
    },
    {
      "id": "gifi.1600",
      "label": "Capital assets at cost",
      "expr": {
        "op": "fact",
        "key": "gifi.1600"
      }
    },
    {
      "id": "gifi.1740",
      "label": "Accumulated amortization of capital assets",
      "note": "Entered as a positive figure and subtracted below, the way it appears on a balance sheet, rather than expecting a negative.",
      "expr": {
        "op": "fact",
        "key": "gifi.1740"
      }
    },
    {
      "id": "gifi.2599",
      "label": "Total assets",
      "expr": {
        "op": "sub",
        "from": {
          "op": "sum",
          "of": [
            {
              "op": "line",
              "id": "gifi.1000"
            },
            {
              "op": "line",
              "id": "gifi.1060"
            },
            {
              "op": "line",
              "id": "gifi.1120"
            },
            {
              "op": "line",
              "id": "gifi.1600"
            }
          ]
        },
        "minus": {
          "op": "line",
          "id": "gifi.1740"
        }
      }
    },
    {
      "id": "gifi.2600",
      "label": "Accounts payable and accrued liabilities",
      "expr": {
        "op": "fact",
        "key": "gifi.2600"
      }
    },
    {
      "id": "gifi.2700",
      "label": "Loans and other long-term debt",
      "expr": {
        "op": "fact",
        "key": "gifi.2700"
      }
    },
    {
      "id": "gifi.3499",
      "label": "Total liabilities",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "gifi.2600"
          },
          {
            "op": "line",
            "id": "gifi.2700"
          }
        ]
      }
    },
    {
      "id": "gifi.3500",
      "label": "Common shares",
      "expr": {
        "op": "fact",
        "key": "gifi.3500"
      }
    },
    {
      "id": "gifi.3600",
      "label": "Retained earnings",
      "expr": {
        "op": "fact",
        "key": "gifi.3600"
      }
    },
    {
      "id": "gifi.3620",
      "label": "Total shareholder equity",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "gifi.3500"
          },
          {
            "op": "line",
            "id": "gifi.3600"
          }
        ]
      }
    },
    {
      "id": "gifi.balance_difference",
      "label": "Balance sheet difference",
      "note": "Assets less liabilities and equity. Anything other than nil means the statements do not balance, which is an error in the accounts rather than in the tax calculation — but it is caught here because the return is where it stops being ignorable.",
      "expr": {
        "op": "sub",
        "from": {
          "op": "line",
          "id": "gifi.2599"
        },
        "minus": {
          "op": "sum",
          "of": [
            {
              "op": "line",
              "id": "gifi.3499"
            },
            {
              "op": "line",
              "id": "gifi.3620"
            }
          ]
        }
      }
    },
    {
      "id": "gifi.8000",
      "label": "Trade sales of goods and services",
      "expr": {
        "op": "fact",
        "key": "gifi.8000"
      }
    },
    {
      "id": "gifi.8090",
      "label": "Investment revenue",
      "expr": {
        "op": "fact",
        "key": "gifi.8090"
      }
    },
    {
      "id": "gifi.8299",
      "label": "Total revenue",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "gifi.8000"
          },
          {
            "op": "line",
            "id": "gifi.8090"
          }
        ]
      }
    },
