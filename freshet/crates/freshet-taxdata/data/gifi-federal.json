        "key": "gifi.9270"
      }
    },
    {
      "id": "gifi.9368",
      "label": "Total expenses",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "gifi.8300"
          },
          {
            "op": "line",
            "id": "gifi.8520"
          },
          {
            "op": "line",
            "id": "gifi.8523"
          },
          {
