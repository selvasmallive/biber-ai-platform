{
  "tax_year": 2025,
  "province": "nu",
  "_comment": "Nunavut. Built structure-first: the shape is real, every number is an unverified placeholder, and what is not yet modelled is declared in the checks rather than left silent.",
  "summary": [
    "fed.15000",
    "fed.23600",
    "fed.26000",
    "fed.42000",
    "prov.tax",
    "summary.total_tax",
    "summary.balance"
  ],
  "checks": [
    {
      "id": "nu.not_modelled_0",
      "severity": "warning",
      "message": "The Nunavut cost of living tax credit, which is refundable, is not modelled.",
      "help": "Freshet does not compute this yet, so a return for this jurisdiction may be incomplete. It is one of the reasons the return cannot be filed.",
      "when": {
        "cmp": "gte",
        "left": {
          "op": "const",
          "value": "1"
        },
        "right": {
          "op": "const",
          "value": "1"
        }
      }
    }
  ],
  "lines": [
    {
      "id": "nu.58040",
      "label": "Nunavut basic personal amount",
      "expr": {
        "op": "param",
        "key": "nu:bpa"
      }
    },
    {
      "id": "nu.58120",
      "label": "Nunavut spouse or common-law partner amount",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "gte",
          "left": {
            "op": "fact",
            "key": "partner.present"
          },
          "right": {
            "op": "const",
            "value": "1"
          }
        },
        "then": {
          "op": "floor_zero",
          "of": {
            "op": "min",
            "of": [
              {
                "op": "sub",
                "from": {
                  "op": "param",
                  "key": "nu:spouse_base"
                },
                "minus": {
                  "op": "fact",
                  "key": "partner.net_income"
                }
              },
              {
                "op": "param",
                "key": "nu:spouse_max"
              }
            ]
          }
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "nu.58160",
      "label": "Nunavut amount for an eligible dependant",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "and",
          "all": [
            {
              "cmp": "lt",
              "left": {
                "op": "fact",
                "key": "partner.present"
              },
              "right": {
                "op": "const",
                "value": "1"
              }
            },
            {
              "cmp": "gte",
              "left": {
                "op": "fact",
                "key": "dependants.eligible_dependant_claimed"
              },
              "right": {
                "op": "const",
                "value": "1"
              }
            }
          ]
        },
        "then": {
          "op": "floor_zero",
          "of": {
            "op": "min",
            "of": [
              {
                "op": "sub",
                "from": {
                  "op": "param",
                  "key": "nu:eligible_dependant_base"
                },
                "minus": {
                  "op": "fact",
                  "key": "dependants.eligible_dependant_net_income"
                }
              },
              {
                "op": "param",
                "key": "nu:eligible_dependant_max"
              }
            ]
          }
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "nu.58185",
      "label": "Nunavut caregiver amount",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "gte",
          "left": {
            "op": "fact",
            "key": "dependants.infirm_adult_claimed"
          },
          "right": {
            "op": "const",
            "value": "1"
          }
        },
        "then": {
          "op": "floor_zero",
          "of": {
            "op": "min",
            "of": [
              {
                "op": "sub",
                "from": {
                  "op": "param",
                  "key": "nu:caregiver_base"
                },
                "minus": {
                  "op": "fact",
                  "key": "dependants.infirm_adult_net_income"
                }
              },
              {
                "op": "param",
                "key": "nu:caregiver_max"
              }
            ]
          }
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "nu.58080",
      "label": "Nunavut age amount",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "gte",
          "left": {
            "op": "fact",
            "key": "taxpayer.age"
          },
          "right": {
            "op": "const",
            "value": "65"
          }
        },
        "then": {
          "op": "floor_zero",
          "of": {
            "op": "sub",
            "from": {
              "op": "param",
              "key": "nu:age_amount_max"
            },
            "minus": {
              "op": "mul",
              "of": {
                "op": "floor_zero",
                "of": {
                  "op": "sub",
                  "from": {
                    "op": "line",
                    "id": "fed.23600"
                  },
                  "minus": {
                    "op": "param",
                    "key": "nu:age_amount_threshold"
                  }
                }
              },
              "by": {
                "op": "param",
                "key": "nu:age_amount_clawback_rate"
              }
            }
          }
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "nu.58360",
      "label": "Nunavut pension income amount",
      "expr": {
        "op": "min",
        "of": [
          {
            "op": "floor_zero",
            "of": {
              "op": "sub",
              "from": {
                "op": "sum",
                "of": [
                  {
                    "op": "line",
                    "id": "fed.11500"
                  },
                  {
                    "op": "mul",
                    "of": {
                      "op": "line",
                      "id": "fed.11600"
                    },
                    "by": {
                      "op": "fact",
                      "key": "pension.split_received_eligible"
                    }
                  }
                ]
              },
              "minus": {
                "op": "line",
                "id": "fed.21000"
              }
            }
          },
          {
            "op": "param",
            "key": "nu:pension_income_max"
          }
        ]
      }
    },
    {
      "id": "nu.58440",
      "label": "Nunavut disability amount",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "gte",
          "left": {
            "op": "fact",
            "key": "disability.claimed"
          },
          "right": {
            "op": "const",
            "value": "1"
          }
        },
        "then": {
          "op": "param",
          "key": "nu:disability_amount"
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "nu.58689",
      "label": "Nunavut allowable medical expenses",
      "expr": {
        "op": "floor_zero",
        "of": {
          "op": "sub",
          "from": {
            "op": "line",
            "id": "fed.33099"
          },
          "minus": {
            "op": "min",
            "of": [
              {
                "op": "mul",
                "of": {
                  "op": "line",
                  "id": "fed.23600"
                },
                "by": {
                  "op": "param",
                  "key": "nu:medical_threshold_rate"
                }
              },
              {
                "op": "param",
                "key": "nu:medical_threshold_cap"
              }
            ]
          }
        }
      }
    },
    {
      "id": "nu.amounts_before_tuition",
      "label": "Nunavut credit amounts before tuition",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "nu.58040"
          },
          {
            "op": "line",
            "id": "nu.58080"
          },
          {
            "op": "line",
            "id": "nu.58120"
          },
          {
            "op": "line",
            "id": "nu.58160"
          },
          {
            "op": "line",
            "id": "nu.58185"
          },
          {
            "op": "line",
            "id": "fed.30800"
          },
          {
            "op": "line",
            "id": "fed.31000"
          },
          {
            "op": "line",
            "id": "fed.31200"
          },
          {
            "op": "line",
            "id": "nu.58360"
          },
          {
            "op": "line",
            "id": "nu.58440"
          },
          {
            "op": "line",
            "id": "nu.58689"
          }
        ]
      }
    },
    {
      "id": "nu.58560",
      "label": "Nunavut tuition amount claimed by the student",
      "expr": {
        "op": "min",
        "of": [
          {
            "op": "fact",
            "key": "tuition.fees"
          },
          {
            "op": "floor_zero",
            "of": {
              "op": "sub",
              "from": {
                "op": "line",
                "id": "fed.26000"
              },
              "minus": {
                "op": "line",
                "id": "nu.amounts_before_tuition"
              }
            }
          }
        ]
      }
    },
    {
      "id": "nu.tuition_transferable",
      "label": "Nunavut tuition available to transfer",
      "expr": {
        "op": "min",
        "of": [
          {
            "op": "floor_zero",
            "of": {
              "op": "sub",
              "from": {
                "op": "fact",
                "key": "tuition.fees"
              },
              "minus": {
                "op": "line",
                "id": "nu.58560"
              }
            }
          },
          {
            "op": "param",
            "key": "nu:tuition_transfer_max"
          }
        ]
      }
    },
    {
      "id": "nu.own_amounts",
      "label": "Your own Nunavut credit amounts",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "nu.amounts_before_tuition"
          },
          {
            "op": "line",
            "id": "nu.58560"
          }
        ]
      }
    },
    {
      "id": "nu.58800",
      "label": "Nunavut total credit amounts",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "nu.own_amounts"
          },
          {
            "op": "fact",
            "key": "partner.nu_transfer_amount"
          }
        ]
      }
    },
    {
      "id": "nu.credits",
      "label": "Nunavut non-refundable tax credits",
      "expr": {
        "op": "mul",
        "of": {
          "op": "line",
          "id": "nu.58800"
        },
        "by": {
          "op": "param",
          "key": "nu:credit_rate"
        }
      }
    },
    {
      "id": "nu.donations",
      "label": "Nunavut donations and gifts",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "mul",
            "of": {
              "op": "min",
              "of": [
                {
                  "op": "fact",
                  "key": "donations.claimed"
                },
                {
                  "op": "param",
                  "key": "nu:donation_first_tier"
                }
              ]
            },
            "by": {
              "op": "param",
              "key": "nu:donation_rate_first"
            }
          },
          {
            "op": "mul",
            "of": {
              "op": "floor_zero",
              "of": {
                "op": "sub",
                "from": {
                  "op": "fact",
                  "key": "donations.claimed"
                },
                "minus": {
                  "op": "param",
                  "key": "nu:donation_first_tier"
                }
              }
            },
            "by": {
              "op": "param",
              "key": "nu:donation_rate_rest"
            }
          }
        ]
      }
    },
    {
      "id": "nu.tax_before_surtax",
      "label": "Nunavut tax before surtax",
      "expr": {
        "op": "floor_zero",
        "of": {
          "op": "sub",
          "from": {
            "op": "sub",
            "from": {
              "op": "bracket",
              "table": "nu:income_tax",
              "base": {
                "op": "line",
                "id": "fed.26000"
              }
            },
            "minus": {
              "op": "line",
              "id": "nu.credits"
            }
          },
          "minus": {
            "op": "line",
            "id": "nu.donations"
          }
        }
      }
    },
    {
      "id": "nu.42800",
      "label": "Nunavut tax",
      "expr": {
        "op": "line",
        "id": "nu.tax_before_surtax"
      }
    },
    {
      "id": "prov.tax",
      "label": "Nunavut tax",
      "expr": {
        "op": "line",
        "id": "nu.42800"
      }
    },
    {
      "id": "prov.refundable_credits",
      "label": "Nunavut refundable credits",
      "note": "Nil, and declared rather than assumed: what is not modelled is listed in the checks. Understating a refund is the safe direction; leaving it unsaid is not.",
      "expr": {
        "op": "const",
        "value": "0"
      }
    }
  ]
}
