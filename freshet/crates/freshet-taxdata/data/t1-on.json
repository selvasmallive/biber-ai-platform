{
  "tax_year": 2025,
  "province": "on",
  "_comment": "Ontario only. Federal lines come from t1-federal.json and are composed in at load time, so nothing federal is repeated here.",
  "checks": [
    {
      "id": "on.health_premium_charged",
      "severity": "info",
      "message": "The Ontario health premium has been added to your Ontario tax.",
      "help": "It is charged on taxable income on a fixed scale above $20,000, and it is added after your credits rather than reduced by them — so it applies even when the rest of your Ontario tax is nil.",
      "when": {
        "cmp": "gt",
        "left": {
          "op": "line",
          "id": "on.health_premium"
        },
        "right": {
          "op": "const",
          "value": "0"
        }
      }
    }
  ],
  "lines": [
    {
      "id": "on.58040",
      "label": "Ontario basic personal amount",
      "expr": {
        "op": "param",
        "key": "on:bpa"
      }
    },
    {
      "id": "on.58120",
      "label": "Ontario spouse or common-law partner amount",
      "note": "Ontario reduces a base amount by the dependant's income and then caps the result, so the base exceeds the maximum. That gap is a band of the dependant's income that costs the claim nothing — a shape the federal equivalent does not share.",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "gte",
          "left": {
            "op": "fact",
            "key": "partner.present"
          },
          "right": {
            "op": "const",
            "value": "1"
          }
        },
        "then": {
          "op": "floor_zero",
          "of": {
            "op": "min",
            "of": [
              {
                "op": "sub",
                "from": {
                  "op": "param",
                  "key": "on:spouse_base"
                },
                "minus": {
                  "op": "fact",
                  "key": "partner.net_income"
                }
              },
              {
                "op": "param",
                "key": "on:spouse_max"
              }
            ]
          }
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "on.58689",
      "label": "Ontario allowable medical expenses",
      "expr": {
        "op": "floor_zero",
        "of": {
          "op": "sub",
          "from": {
            "op": "line",
            "id": "fed.33099"
          },
          "minus": {
            "op": "min",
            "of": [
              {
                "op": "mul",
                "of": {
                  "op": "line",
                  "id": "fed.23600"
                },
                "by": {
                  "op": "param",
                  "key": "on:medical_threshold_rate"
                }
              },
              {
                "op": "param",
                "key": "on:medical_threshold_cap"
              }
            ]
          }
        }
      }
    },
    {
      "id": "on.58160",
      "label": "Ontario amount for an eligible dependant",
      "note": "Ontario reduces a base amount by the dependant's income and then caps the result, so the base exceeds the maximum. That gap is a band of the dependant's income that costs the claim nothing — a shape the federal equivalent does not share.",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "and",
          "all": [
            {
              "cmp": "lt",
              "left": {
                "op": "fact",
                "key": "partner.present"
              },
              "right": {
                "op": "const",
                "value": "1"
              }
            },
            {
              "cmp": "gte",
              "left": {
                "op": "fact",
                "key": "dependants.eligible_dependant_claimed"
              },
              "right": {
                "op": "const",
                "value": "1"
              }
            }
          ]
        },
        "then": {
          "op": "floor_zero",
          "of": {
            "op": "min",
            "of": [
              {
                "op": "sub",
                "from": {
                  "op": "param",
                  "key": "on:eligible_dependant_base"
                },
                "minus": {
                  "op": "fact",
                  "key": "dependants.eligible_dependant_net_income"
                }
              },
              {
                "op": "param",
                "key": "on:eligible_dependant_max"
              }
            ]
          }
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "on.58185",
      "label": "Ontario caregiver amount",
      "note": "Worksheet ON428: a $26,562 base reduced by the dependant's income and capped at $6,008. The previous model treated it as an amount reduced above a threshold, which is a different curve entirely.",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "gte",
          "left": {
            "op": "fact",
            "key": "dependants.infirm_adult_claimed"
          },
          "right": {
            "op": "const",
            "value": "1"
          }
        },
        "then": {
          "op": "floor_zero",
          "of": {
            "op": "min",
            "of": [
              {
                "op": "sub",
                "from": {
                  "op": "param",
                  "key": "on:caregiver_base"
                },
                "minus": {
                  "op": "fact",
                  "key": "dependants.infirm_adult_net_income"
                }
              },
              {
                "op": "param",
                "key": "on:caregiver_max"
              }
            ]
          }
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "on.58080",
      "label": "Ontario age amount",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "gte",
          "left": {
            "op": "fact",
            "key": "taxpayer.age"
          },
          "right": {
            "op": "const",
            "value": "65"
          }
        },
        "then": {
          "op": "floor_zero",
          "of": {
            "op": "sub",
            "from": {
              "op": "param",
              "key": "on:age_amount_max"
            },
            "minus": {
              "op": "mul",
              "of": {
                "op": "floor_zero",
                "of": {
                  "op": "sub",
                  "from": {
                    "op": "line",
                    "id": "fed.23600"
                  },
                  "minus": {
                    "op": "param",
                    "key": "on:age_amount_threshold"
                  }
                }
              },
              "by": {
                "op": "param",
                "key": "on:age_amount_clawback_rate"
              }
            }
          }
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "on.58360",
      "label": "Ontario pension income amount",
      "expr": {
        "op": "min",
        "of": [
          {
            "op": "floor_zero",
            "of": {
              "op": "sub",
              "from": {
                "op": "sum",
                "of": [
                  {
                    "op": "line",
                    "id": "fed.11500"
                  },
                  {
                    "op": "mul",
                    "of": {
                      "op": "line",
                      "id": "fed.11600"
                    },
                    "by": {
                      "op": "fact",
                      "key": "pension.split_received_eligible"
                    }
                  }
                ]
              },
              "minus": {
                "op": "line",
                "id": "fed.21000"
              }
            }
          },
          {
            "op": "param",
            "key": "on:pension_income_max"
          }
        ]
      }
    },
    {
      "id": "on.58440",
      "label": "Ontario disability amount",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "gte",
          "left": {
            "op": "fact",
            "key": "disability.claimed"
          },
          "right": {
            "op": "const",
            "value": "1"
          }
        },
        "then": {
          "op": "param",
          "key": "on:disability_amount"
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "on.amounts_before_tuition",
      "label": "Ontario credit amounts before tuition",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "on.58040"
          },
          {
            "op": "line",
            "id": "on.58080"
          },
          {
            "op": "line",
            "id": "on.58120"
          },
          {
            "op": "line",
            "id": "on.58160"
          },
          {
            "op": "line",
            "id": "on.58185"
          },
          {
            "op": "line",
            "id": "fed.30800"
          },
          {
            "op": "line",
            "id": "fed.31000"
          },
          {
            "op": "line",
            "id": "fed.31200"
          },
          {
            "op": "line",
            "id": "on.58360"
          },
          {
            "op": "line",
            "id": "on.58440"
          },
          {
            "op": "line",
            "id": "on.58689"
          }
        ]
      }
    },
    {
      "id": "on.58560",
      "label": "Ontario tuition amount claimed by the student",
      "expr": {
        "op": "const",
        "value": "0"
      },
      "note": "Ontario abolished the tuition and education amounts for studies after 5 September 2017, so current-year fees earn no Ontario credit and none can be transferred. Only pre-2017 carryforward survives, and this model does not track it — which understates rather than overstates, the only safe direction to be wrong in."
    },
    {
      "id": "on.tuition_transferable",
      "label": "Ontario tuition available to transfer",
      "expr": {
        "op": "const",
        "value": "0"
      },
      "note": "Ontario abolished the tuition and education amounts for studies after 5 September 2017, so current-year fees earn no Ontario credit and none can be transferred. Only pre-2017 carryforward survives, and this model does not track it — which understates rather than overstates, the only safe direction to be wrong in."
    },
    {
      "id": "on.own_amounts",
      "label": "Your own Ontario credit amounts",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "on.amounts_before_tuition"
          },
          {
            "op": "line",
            "id": "on.58560"
          }
        ]
      }
    },
    {
      "id": "on.unused_transferable",
      "label": "Ontario amounts available to transfer to your spouse",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "floor_zero",
            "of": {
              "op": "sub",
              "from": {
                "op": "sum",
                "of": [
                  {
                    "op": "line",
                    "id": "on.58080"
                  },
                  {
                    "op": "line",
                    "id": "on.58360"
                  },
                  {
                    "op": "line",
                    "id": "on.58440"
                  }
                ]
              },
              "minus": {
                "op": "floor_zero",
                "of": {
                  "op": "sub",
                  "from": {
                    "op": "line",
                    "id": "fed.26000"
                  },
                  "minus": {
                    "op": "sub",
                    "from": {
                      "op": "line",
                      "id": "on.own_amounts"
                    },
                    "minus": {
                      "op": "sum",
                      "of": [
                        {
                          "op": "line",
                          "id": "on.58080"
                        },
                        {
                          "op": "line",
                          "id": "on.58360"
                        },
                        {
                          "op": "line",
                          "id": "on.58440"
                        },
                        {
                          "op": "line",
                          "id": "on.58560"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "op": "line",
            "id": "on.tuition_transferable"
          }
        ]
      }
    },
    {
      "id": "on.58640",
      "label": "Ontario amounts transferred from your spouse",
      "expr": {
        "op": "fact",
        "key": "partner.on_transfer_amount"
      }
    },
    {
      "id": "on.58800",
      "label": "Ontario total credit amounts",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "on.own_amounts"
          },
          {
            "op": "line",
            "id": "on.58640"
          }
        ]
      }
    },
    {
      "id": "on.61500",
      "label": "Ontario non-refundable tax credits",
      "expr": {
        "op": "mul",
        "of": {
          "op": "line",
          "id": "on.58800"
        },
        "by": {
          "op": "param",
          "key": "on:credit_rate"
        }
      }
    },
    {
      "id": "on.donations",
      "label": "Ontario donations and gifts",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "mul",
            "of": {
              "op": "min",
              "of": [
                {
                  "op": "fact",
                  "key": "donations.claimed"
                },
                {
                  "op": "param",
                  "key": "on:donation_first_tier"
                }
              ]
            },
            "by": {
              "op": "param",
              "key": "on:donation_rate_first"
            }
          },
          {
            "op": "mul",
            "of": {
              "op": "floor_zero",
              "of": {
                "op": "sub",
                "from": {
                  "op": "fact",
                  "key": "donations.claimed"
                },
                "minus": {
                  "op": "param",
                  "key": "on:donation_first_tier"
                }
              }
            },
            "by": {
              "op": "param",
              "key": "on:donation_rate_rest"
            }
          }
        ]
      }
    },
    {
      "id": "on.tax_before_surtax",
      "label": "Ontario tax before surtax",
      "expr": {
        "op": "floor_zero",
        "of": {
          "op": "sub",
          "from": {
            "op": "sub",
            "from": {
              "op": "bracket",
              "table": "on:income_tax",
              "base": {
                "op": "line",
                "id": "fed.26000"
              }
            },
            "minus": {
              "op": "line",
              "id": "on.61500"
            }
          },
          "minus": {
            "op": "line",
            "id": "on.donations"
          }
        }
      }
    },
    {
      "id": "on.surtax",
      "label": "Ontario surtax",
      "note": "Ontario taxes its own tax: 20% of the amount above the first threshold, plus a further 36% above the second.",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "mul",
            "of": {
              "op": "floor_zero",
              "of": {
                "op": "sub",
                "from": {
                  "op": "line",
                  "id": "on.tax_before_surtax"
                },
                "minus": {
                  "op": "param",
                  "key": "on:surtax_threshold_1"
                }
              }
            },
            "by": {
              "op": "param",
              "key": "on:surtax_rate_1"
            }
          },
          {
            "op": "mul",
            "of": {
              "op": "floor_zero",
              "of": {
                "op": "sub",
                "from": {
                  "op": "line",
                  "id": "on.tax_before_surtax"
                },
                "minus": {
                  "op": "param",
                  "key": "on:surtax_threshold_2"
                }
              }
            },
            "by": {
              "op": "param",
              "key": "on:surtax_rate_2"
            }
          }
        ]
      }
    },
    {
      "id": "on.tax_after_surtax",
      "label": "Ontario tax after surtax",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "on.tax_before_surtax"
          },
          {
            "op": "line",
            "id": "on.surtax"
          }
        ]
      }
    },
    {
      "id": "on.tax_reduction_amounts",
      "label": "Ontario tax reduction amounts",
      "note": "Basic reduction plus an amount for each dependent child and each dependant with an impairment. In a couple only the higher earner may claim the dependant amounts, which the coupled solver enforces.",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "param",
            "key": "on:tax_reduction_basic"
          },
          {
            "op": "if",
            "cond": {
              "cmp": "lt",
              "left": {
                "op": "fact",
                "key": "on_reduction.dependants_suppressed"
              },
              "right": {
                "op": "const",
                "value": "1"
              }
            },
            "then": {
              "op": "mul",
              "of": {
                "op": "sum",
                "of": [
                  {
                    "op": "fact",
                    "key": "dependants.count_minor"
                  },
                  {
                    "op": "fact",
                    "key": "dependants.count_impaired"
                  }
                ]
              },
              "by": {
                "op": "param",
                "key": "on:tax_reduction_per_dependant"
              }
            },
            "else": {
              "op": "const",
              "value": "0"
            }
          }
        ]
      }
    },
    {
      "id": "on.tax_reduction",
      "label": "Ontario tax reduction",
      "note": "Twice the reduction amounts less the tax itself. The effect is that tax is eliminated entirely below the reduction amount and tapers to nothing at twice it, rather than being a flat credit.",
      "expr": {
        "op": "floor_zero",
        "of": {
          "op": "sub",
          "from": {
            "op": "mul",
            "of": {
              "op": "line",
              "id": "on.tax_reduction_amounts"
            },
            "by": {
              "op": "const",
              "value": "2"
            }
          },
          "minus": {
            "op": "line",
            "id": "on.tax_after_surtax"
          }
        }
      }
    },
    {
      "id": "on.tax_after_reduction",
      "label": "Ontario tax after the reduction",
      "expr": {
        "op": "floor_zero",
        "of": {
          "op": "sub",
          "from": {
            "op": "line",
            "id": "on.tax_after_surtax"
          },
          "minus": {
            "op": "line",
            "id": "on.tax_reduction"
          }
        }
      }
    },
    {
      "id": "on.health_premium",
      "label": "Ontario health premium",
      "note": "Line 89. Added to Ontario tax rather than deducted, and charged on taxable income regardless of what credits reduced the tax to. Expressed as five clamped ramps; the chart's flat plateaus fall out of the arithmetic.",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "mul",
            "of": {
              "op": "clamp",
              "lo": {
                "op": "const",
                "value": "0"
              },
              "hi": {
                "op": "param",
                "key": "on:health_premium_ramp1_width"
              },
              "value": {
                "op": "sub",
                "from": {
                  "op": "line",
                  "id": "fed.26000"
                },
                "minus": {
                  "op": "param",
                  "key": "on:health_premium_ramp1_start"
                }
              }
            },
            "by": {
              "op": "param",
              "key": "on:health_premium_ramp1_rate"
            }
          },
          {
            "op": "mul",
            "of": {
              "op": "clamp",
              "lo": {
                "op": "const",
                "value": "0"
              },
              "hi": {
                "op": "param",
                "key": "on:health_premium_ramp2_width"
              },
              "value": {
                "op": "sub",
                "from": {
                  "op": "line",
                  "id": "fed.26000"
                },
                "minus": {
                  "op": "param",
                  "key": "on:health_premium_ramp2_start"
                }
              }
            },
            "by": {
              "op": "param",
              "key": "on:health_premium_ramp2_rate"
            }
          },
          {
            "op": "mul",
            "of": {
              "op": "clamp",
              "lo": {
                "op": "const",
                "value": "0"
              },
              "hi": {
                "op": "param",
                "key": "on:health_premium_ramp3_width"
              },
              "value": {
                "op": "sub",
                "from": {
                  "op": "line",
                  "id": "fed.26000"
                },
                "minus": {
                  "op": "param",
                  "key": "on:health_premium_ramp3_start"
                }
              }
            },
            "by": {
              "op": "param",
              "key": "on:health_premium_ramp3_rate"
            }
          },
          {
            "op": "mul",
            "of": {
              "op": "clamp",
              "lo": {
                "op": "const",
                "value": "0"
              },
              "hi": {
                "op": "param",
                "key": "on:health_premium_ramp4_width"
              },
              "value": {
                "op": "sub",
                "from": {
                  "op": "line",
                  "id": "fed.26000"
                },
                "minus": {
                  "op": "param",
                  "key": "on:health_premium_ramp4_start"
                }
              }
            },
            "by": {
              "op": "param",
              "key": "on:health_premium_ramp4_rate"
            }
          },
          {
            "op": "mul",
            "of": {
              "op": "clamp",
              "lo": {
                "op": "const",
                "value": "0"
              },
              "hi": {
                "op": "param",
                "key": "on:health_premium_ramp5_width"
              },
              "value": {
                "op": "sub",
                "from": {
                  "op": "line",
                  "id": "fed.26000"
                },
                "minus": {
                  "op": "param",
                  "key": "on:health_premium_ramp5_start"
                }
              }
            },
            "by": {
              "op": "param",
              "key": "on:health_premium_ramp5_rate"
            }
          }
        ]
      }
    },
    {
      "id": "on.42800",
      "label": "Ontario tax",
      "note": "Tax after the surtax and the reduction, plus the health premium, in that order.",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "on.tax_after_reduction"
          },
          {
            "op": "line",
            "id": "on.health_premium"
          }
        ]
      }
    },
    {
      "id": "on.care_income",
      "label": "Adjusted family income for the CARE credit",
      "note": "Both partners' net income. For a single filer the household figure is absent, so their own net income stands in.",
      "expr": {
        "op": "max",
        "of": [
          {
            "op": "line",
            "id": "fed.23600"
          },
          {
            "op": "fact",
            "key": "household.net_income"
          }
        ]
      }
    },
    {
      "id": "on.care_rate",
      "label": "Ontario CARE credit rate",
      "note": "A step function: the rate drops two points for each whole or partial band above each tier floor, which is why it is computed with a ceiling rather than interpolated.",
      "expr": {
