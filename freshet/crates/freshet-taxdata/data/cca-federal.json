    {
      "id": "fed.cca_class10_1_capped_cost",
      "label": "Class 10.1 cost, capped at the passenger vehicle limit",
      "note": "Anything paid above the limit is simply not depreciable.",
      "expr": {
        "op": "min",
        "of": [
          {
            "op": "fact",
            "key": "cca.class10_1.additions"
          },
          {
            "op": "param",
            "key": "fed:vehicle_cost_limit"
          }
        ]
      }
    },
    {
      "id": "fed.cca_class10_1_base",
      "label": "Class 10.1 base for capital cost allowance",
      "expr": {
        "op": "floor_zero",
        "of": {
          "op": "sum",
          "of": [
            {
              "op": "sub",
              "from": {
                "op": "sum",
                "of": [
                  {
                    "op": "fact",
                    "key": "cca.class10_1.opening_ucc"
                  },
                  {
                    "op": "line",
                    "id": "fed.cca_class10_1_capped_cost"
                  }
                ]
              },
              "minus": {
                "op": "fact",
                "key": "cca.class10_1.dispositions"
              }
            },
            {
              "op": "mul",
              "of": {
                "op": "floor_zero",
                "of": {
                  "op": "sub",
                  "from": {
                    "op": "line",
                    "id": "fed.cca_class10_1_capped_cost"
                  },
                  "minus": {
                    "op": "fact",
                    "key": "cca.class10_1.dispositions"
                  }
                }
              },
