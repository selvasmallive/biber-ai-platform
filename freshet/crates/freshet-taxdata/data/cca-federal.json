                "op": "param",
                "key": "fed:cca_first_year_adjustment"
              }
            }
          ]
        }
      }
    },
    {
      "id": "fed.cca_class10_1",
      "label": "Capital cost allowance, class 10.1 — passenger vehicle above the cost limit",
      "note": "Neither recapture nor a terminal loss ever arises on class 10.1, however the vehicle is sold.",
      "expr": {
        "op": "mul",
        "of": {
          "op": "line",
          "id": "fed.cca_class10_1_base"
        },
        "by": {
          "op": "param",
          "key": "fed:cca_rate_class10_1"
        }
      }
    },
    {
      "id": "fed.cca_maximum",
      "label": "Maximum capital cost allowance available",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "fed.cca_class8"
          },
          {
            "op": "line",
            "id": "fed.cca_class10"
          },
          {
            "op": "line",
            "id": "fed.cca_class12"
          },
          {
            "op": "line",
            "id": "fed.cca_class50"
          },
          {
            "op": "line",
            "id": "fed.cca_class10_1"
          }
        ]
      }
    },
    {
      "id": "fed.cca_total",
      "label": "Capital cost allowance claimed",
      "note": "CCA is discretionary: any amount from nil up to the maximum. Claiming less leaves the balance in the pool for a later year, which is worth doing when this year's income is already covered by personal amounts.",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "gte",
          "left": {
            "op": "fact",
            "key": "cca.limit_claim"
          },
          "right": {
            "op": "const",
            "value": "1"
          }
        },
        "then": {
          "op": "clamp",
          "lo": {
            "op": "const",
            "value": "0"
          },
          "hi": {
            "op": "line",
            "id": "fed.cca_maximum"
          },
          "value": {
            "op": "fact",
            "key": "cca.claimed"
          }
        },
        "else": {
          "op": "line",
          "id": "fed.cca_maximum"
        }
      }
    },
    {
      "id": "fed.recapture_total",
      "label": "Total recapture of capital cost allowance",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "fed.cca_class8_recapture"
          },
          {
            "op": "line",
            "id": "fed.cca_class10_recapture"
          },
          {
            "op": "line",
            "id": "fed.cca_class12_recapture"
          },
          {
            "op": "line",
            "id": "fed.cca_class50_recapture"
          }
        ]
      }
    },
    {
      "id": "fed.terminal_loss_total",
      "label": "Total terminal losses",
      "expr": {
        "op": "sum",
        "of": [
          {
            "op": "line",
            "id": "fed.cca_class8_terminal"
          },
          {
            "op": "line",
            "id": "fed.cca_class10_terminal"
