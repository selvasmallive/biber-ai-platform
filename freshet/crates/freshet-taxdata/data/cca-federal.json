{
  "tax_year": 2025,
  "province": "on",
  "_comment": "Capital cost allowance: the pool arithmetic, shared by the T1 and the T2. Classes, the half-year rule, recapture and terminal loss are the same statute whoever is claiming, so this lives once and is merged into both federal forms. Line ids are unchanged from when this was part of t1-federal.json, so the T1 golden vectors still reference them and still pass — which is the evidence the extraction moved nothing.",
  "summary": [],
  "checks": [
    {
      "id": "cca.recapture",
      "severity": "info",
      "message": "Selling business assets has produced recaptured capital cost allowance.",
      "help": "You sold for more than the pool's remaining tax value, so depreciation you deducted in earlier years is added back to this year's business income. It is expected, not a mistake.",
      "when": {
        "cmp": "gt",
        "left": {
          "op": "line",
          "id": "fed.recapture_total"
        },
        "right": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "cca.terminal_loss",
      "severity": "info",
      "message": "A terminal loss has been claimed on a class you have emptied.",
      "help": "The value left in the pool when the last asset goes is deductible in full. Confirm the class really is empty — a terminal loss cannot be claimed while any asset remains in it.",
      "when": {
        "cmp": "gt",
        "left": {
          "op": "line",
          "id": "fed.terminal_loss_total"
        },
        "right": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "cca.claimed_below_maximum",
      "severity": "info",
      "message": "You are claiming less capital cost allowance than you could.",
      "help": "That is a legitimate choice — the unclaimed amount stays in the pool and can be deducted in a later year, which is usually better when this year's income is already covered by your personal amounts. Check the planner on the return summary before deciding.",
      "when": {
        "cmp": "gt",
        "left": {
          "op": "sub",
          "from": {
            "op": "line",
            "id": "fed.cca_maximum"
          },
          "minus": {
            "op": "line",
            "id": "fed.cca_total"
          }
        },
        "right": {
          "op": "const",
          "value": "0"
        }
      }
    }
  ],
  "lines": [
    {
      "id": "fed.cca_class8_raw",
      "label": "Class 8 balance after additions and dispositions",
      "note": "May go negative — that is recapture, not an error.",
      "expr": {
        "op": "sub",
        "from": {
          "op": "sum",
          "of": [
            {
              "op": "fact",
              "key": "cca.class8.opening_ucc"
            },
            {
              "op": "fact",
              "key": "cca.class8.additions"
            }
          ]
        },
        "minus": {
          "op": "fact",
          "key": "cca.class8.dispositions"
        }
      }
    },
    {
      "id": "fed.cca_class8_recapture",
      "label": "Class 8 recapture",
      "note": "Selling for more than the pool's remaining value claws back depreciation already deducted. It is income, not a smaller deduction.",
      "expr": {
        "op": "floor_zero",
        "of": {
          "op": "mul",
          "of": {
            "op": "line",
            "id": "fed.cca_class8_raw"
          },
          "by": {
            "op": "const",
            "value": "-1"
          }
        }
      }
    },
    {
      "id": "fed.cca_class8_terminal",
      "label": "Class 8 terminal loss",
      "note": "When the last asset in a class goes and value remains in the pool, the remainder is deductible in full — but only once the class is empty.",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "and",
          "all": [
            {
              "cmp": "gte",
              "left": {
                "op": "fact",
                "key": "cca.class8.all_disposed"
              },
              "right": {
                "op": "const",
                "value": "1"
              }
            },
            {
              "cmp": "gt",
              "left": {
                "op": "line",
                "id": "fed.cca_class8_raw"
              },
              "right": {
                "op": "const",
                "value": "0"
              }
            }
          ]
        },
        "then": {
          "op": "line",
          "id": "fed.cca_class8_raw"
        },
        "else": {
          "op": "const",
          "value": "0"
        }
      }
    },
    {
      "id": "fed.cca_class8_base",
      "label": "Class 8 base for capital cost allowance",
      "note": "A pool in recapture or wound up by a terminal loss has no balance left to depreciate.",
      "expr": {
        "op": "if",
        "cond": {
          "cmp": "or",
          "any": [
            {
              "cmp": "gt",
              "left": {
                "op": "line",
                "id": "fed.cca_class8_recapture"
              },
              "right": {
                "op": "const",
                "value": "0"
              }
            },
            {
              "cmp": "gt",
              "left": {
                "op": "line",
                "id": "fed.cca_class8_terminal"
              },
              "right": {
                "op": "const",
                "value": "0"
              }
            }
          ]
        },
        "then": {
          "op": "const",
          "value": "0"
        },
        "else": {
          "op": "floor_zero",
          "of": {
            "op": "sum",
            "of": [
              {
                "op": "line",
                "id": "fed.cca_class8_raw"
              },
              {
                "op": "mul",
                "of": {
                  "op": "floor_zero",
                  "of": {
                    "op": "sub",
                    "from": {
                      "op": "fact",
                      "key": "cca.class8.additions"
                    },
                    "minus": {
                      "op": "fact",
                      "key": "cca.class8.dispositions"
                    }
                  }
                },
                "by": {
                  "op": "param",
                  "key": "fed:cca_first_year_adjustment"
                }
              }
            ]
          }
        }
      }
    },
